
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build raylib",
            "type": "shell",
            "command": "C:\\raylib\\w64devkit\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-IC:\\raylib\\w64devkit\\include",
                "-LC:\\raylib\\w64devkit\\lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
